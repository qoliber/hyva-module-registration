{
    "name": "qoliber/hyva-module-registration",
    "description": "Qoliber Hyva Module Registration - Automatically registers Qoliber modules for Hyva themes",
    "type": "magento2-module",
    "version": "1.0.3",
    "license": "proprietary",
    "authors": [
        {
            "name": "qoliber",
            "email": "extensions@qoliber.com",
            "homepage": "https://qoliber.com"
        }
    ],
    "homepage": "https://qoliber.com",
    "support": {
        "email": "extensions@qoliber.com",
        "source": "https://gitlab.qoliber.com/qoliber/hyva-module-registration"
    },
    "keywords": [
        "magento2",
        "magento",
        "hyva",
        "registration",
        "compatibility"
    ],
    "source": {
        "type": "git",
        "url": "git@gitlab.qoliber.com:qoliber/hyva-module-registration.git",
        "reference": "main"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "hyva-themes/magento2-theme-module": "^1.3",
        "magento/framework": "^103.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Qoliber\\HyvaModuleRegistration\\": ""
        }
    },
    "minimum-stability": "stable"
}
